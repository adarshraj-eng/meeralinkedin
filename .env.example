# --- Required ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-@BotFather
GEMINI_API_KEY=your-key-from-aistudio.google.com/apikey

# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Send /whoami to the bot to find yours, then put it here and restart.
ALLOWED_USER_IDS=

# --- Optional ---
# gemini-3.6-flash is the default: currently the fastest and most available.
# On a paid tier, try gemini-3.1-pro-preview and compare on real briefs.
GEMINI_MODEL=gemini-3.6-flash

# Tried in order when the primary model returns 503 (busy) or 429 (over quota).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-lite-latest
DATA_DIR=./data

# --- Optional: direct LinkedIn publishing (OFF by default) ---
# Leave blank to keep the bot copy-paste only. Even when filled in,
# nothing is ever posted without an explicit /publish on an approved draft.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# --- Only needed when deploying to Vercel (see README "Deploying to Vercel") ---
# Set automatically once a Redis store (Marketplace > Upstash) is attached to
# the Vercel project - don't set them by hand there. For local development
# against the same storage, `vercel env pull .env` pulls them down for you;
# leave both blank to keep using local JSON files instead. Either naming
# works: KV_REST_API_URL/TOKEN (older "KV" integration) or
# UPSTASH_REDIS_REST_URL/TOKEN (current Redis integration).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Checked against Telegram's X-Telegram-Bot-Api-Secret-Token header on every
# webhook call. Make one up (e.g. `openssl rand -hex 32`), put it here AND
# pass it to scripts/set-webhook.mjs.
TELEGRAM_WEBHOOK_SECRET=

# Vercel sends this as `Authorization: Bearer $CRON_SECRET` on Cron Job
# requests once it's set in the project's env vars. Make one up the same way.
CRON_SECRET=
